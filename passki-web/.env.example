# Demo relying party
PASSKI_RP_ID=passki.alirezaiyan.com
PASSKI_RP_NAME=PassKi demo
PASSKI_ANDROID_PACKAGE=com.alirezaiyan.passki
# Comma-separated SHA-256 fingerprints (colon hex) for the demo assetlinks.json and android:apk-key-hash origins
# First: the committed sample keystore (samples/debug). Second (commented): example of an additional signing key.
PASSKI_ANDROID_FINGERPRINTS=59:E5:92:32:4E:6C:E6:FA:5F:E2:F0:8A:39:18:13:2D:A5:1D:DE:5D:F9:BD:11:F0:5C:E8:23:57:88:E2:06:C0
# PASSKI_ANDROID_FINGERPRINTS=59:E5:92:32:4E:6C:E6:FA:5F:E2:F0:8A:39:18:13:2D:A5:1D:DE:5D:F9:BD:11:F0:5C:E8:23:57:88:E2:06:C0,C9:64:0F:6A:68:90:AF:6C:26:49:DC:BB:AB:94:79:23:93:5C:FC:10:8B:DF:03:20:78:04:60:5C:5B:79:49:03
# Base TEAM.bundle IDs always in the demo AASA
PASSKI_APPLE_APP_IDS=VFCFJC7Y5J.com.alirezaiyan.passki.PassKi
# Optional extra accepted origins (e.g. http://localhost:3000 for a local browser demo)
PASSKI_EXTRA_ORIGINS=
# Storage
PASSKI_DB_PATH=./data/passki.db
PASSKI_IP_SALT=change-me
# Self-service iOS limits
PASSKI_IOS_PER_IP_PER_DAY=5
PASSKI_IOS_MAX_ACTIVE=500
