// Shared settings. Your own Apple Developer Team ID goes in Local.xcconfig (gitignored), which overrides these:
//   cp iosApp/Configuration/Local.xcconfig.example iosApp/Configuration/Local.xcconfig
TEAM_ID=

PRODUCT_NAME=PassKi
PRODUCT_BUNDLE_IDENTIFIER=com.alirezaiyan.passki.PassKi

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
CODE_SIGN_ENTITLEMENTS = iosApp/iosApp.entitlements

#include? "Local.xcconfig"
